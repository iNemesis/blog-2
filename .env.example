# Configuration SFTP pour le déploiement du dossier docs/
SFTP_HOST=ssh.mon-serveur.com
SFTP_PORT=22
SFTP_USER=mon_utilisateur

# Authentification par mot de passe :
SFTP_PASSWORD=mon_mot_de_passe

# OU authentification par clé SSH :
# SFTP_KEY_PATH=C:/Users/mon_nom/.ssh/id_ed25519
# SFTP_KEY_PASSPHRASE=ma_passphrase_optionnelle

# Dossier distant sur le serveur
SFTP_DIR=/var/www/mon-site
